CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://insightsrag.vercel.app
STORAGE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=insightgraph
MAX_UPLOAD_SIZE_BYTES=52428800
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
ENABLE_KNOWLEDGE_GRAPH=false

# OpenDataLoader is the primary PDF parser. Java 11+ is required at runtime.
# Leave hybrid blank for local structured parsing; configure these when a
# separate OpenDataLoader hybrid server is available for complex/scanned PDFs.
OPENDATALOADER_HYBRID=
OPENDATALOADER_HYBRID_URL=
OPENDATALOADER_HYBRID_MODE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
