{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/ask",
      "destination": "https://insightgraph-rag-api.onrender.com/api/chat"
    },
    {
      "source": "/api/:match*",
      "destination": "https://insightgraph-rag-api.onrender.com/api/:match*"
    }
  ]
}
